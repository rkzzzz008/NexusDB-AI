# NexusDB AI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# GEMINI AI CONFIGURATION (REQUIRED)
# ============================================

# GEMINI_API_KEY: Get from https://aistudio.google.com/app/apikeys
# Required for AI features:
# - AI Assistant natural language queries
# - Database schema generation with AI
# - Data cleaning analysis
# - Executive reports with KPI analysis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ============================================
# MONGODB ATLAS CONFIGURATION (OPTIONAL)
# ============================================

# MONGODB_URI: Optional MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=NexusDB
#
# SETUP INSTRUCTIONS:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create free account and cluster
# 3. Click "Connect" → "Drivers" → "Node.js"
# 4. Copy connection string
# 5. Replace <username> and <password> with your credentials
# 6. Add your IP to Atlas IP Whitelist (0.0.0.0 for all IPs)
#
# NOTES:
# - If empty, app uses disk-based JSON storage (data/nexus_db.json)
# - Data automatically syncs to disk for resilience
# - MongoDB is fully optional and not required to run
#
# TROUBLESHOOTING:
# - "SSL alert number 80": Add your IP to Atlas IP Whitelist
# - "MongoServerSelectionError": Check cluster is running and credentials correct
# - "Connection timeout": Verify firewall allows outbound HTTPS (port 27017)
# - Check server logs for [MongoDB] connection status messages
#
MONGODB_URI=""

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT_SECRET: Secret key for signing JWT authentication tokens
# Change this to a random strong string in production!
JWT_SECRET="nexus_db_ai_secret_jwt_key_2026"

# ============================================
# APPLICATION URLs
# ============================================

# APP_URL: URL where this application is hosted (for OAuth, share links, etc)
APP_URL="http://localhost:3000"

# ============================================
# DEVELOPMENT OPTIONS
# ============================================

# NODE_ENV: Server environment (development or production)
NODE_ENV="development"

# DISABLE_HMR: Set to 'true' to disable Hot Module Replacement
# Reduces CPU usage during development if you experience flickering
DISABLE_HMR=false

